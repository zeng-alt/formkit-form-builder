{
  "name": "@zeng-alt/formkit-form-builder",
  "version": "0.1.4",
  "description": "A visual FormKit schema builder for Vue 3",
  "type": "module",
  "license": "LGPL",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeng-alt/formkit-form-builder.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "formkit",
    "form-builder",
    "schema",
    "drag-and-drop"
  ],
  "main": "./dist/builder.umd.js",
  "module": "./dist/builder.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/builder.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/builder.es.js",
      "require": "./dist/builder.umd.js"
    },
    "./builder.css": "./dist/builder.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.2.1",
    "naive-ui": "^2.44.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.2",
    "@formkit/core": "^2.0.0",
    "@formkit/drag-and-drop": "^0.5.0",
    "@formkit/i18n": "^2.0.0",
    "@formkit/vue": "^2.0.0",
    "@internationalized/date": "^3.12.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "openai": "^6.34.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@formkit/core": "^2.0.0",
    "@formkit/drag-and-drop": "^0.5.3",
    "@formkit/vue": "^2.0.0",
    "@iconify-json/lucide": "^1.2.58",
    "@iconify-json/stash": "^1.2.3",
    "@iconify/utils": "^3.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "naive-ui": "^2.44.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.42.0",
    "oxlint": "~1.57.0",
    "playwright-core": "^1.49.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "unocss": "^66.6.8",
    "unocss-tw-animate-css": "^0.1.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue": "^3.5.31",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
